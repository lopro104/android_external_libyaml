cc_library_static {
    name: "libyaml",
    visibility: ["//external/libcamera", "//external/libcamera-mainline"],

    export_include_dirs: [
        "include",
    ],

    cflags: [
        "-DYAML_VERSION_MAJOR=0",
        "-DYAML_VERSION_MINOR=2",
        "-DYAML_VERSION_PATCH=5",
        "-DYAML_VERSION_STRING=\"0.2.5\"",
    ],
    srcs: [
        "src/api.c",
        "src/dumper.c",
        "src/emitter.c",
        "src/loader.c",
        "src/parser.c",
        "src/reader.c",
        "src/scanner.c",
        "src/writer.c",
    ],
    vendor_available: true,
}
